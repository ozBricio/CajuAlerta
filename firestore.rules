rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isStaff() {
      return request.auth != null && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.role == 'staff';
    }
    
    function isAuth() {
      return request.auth != null;
    }

    match /usuarios/{userId} {
      // Impede injeção de role staff na criação
      allow create: if isAuth() && request.auth.uid == userId && (!request.resource.data.keys().hasAll(['role']) || request.resource.data.role != 'staff');
      // Apenas o próprio dono ou staff podem ler
      allow read: if isAuth() && (request.auth.uid == userId || isStaff());
      // Impede alteração de role na atualização e obriga validação de campos permitidos
      allow update: if isAuth() && (
        (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])) || 
        isStaff()
      );
      allow delete: if false;
    }

    match /historico_acessos/{logId} {
      allow create: if isAuth() && request.resource.data.uid == request.auth.uid;
      allow read: if isStaff();
      allow update, delete: if false;
    }

    match /logs_exclusao/{logId} {
      allow create: if isAuth() && request.resource.data.uid == request.auth.uid;
      allow read: if isStaff();
      allow update, delete: if false;
    }

    match /denuncias_emails/{docId} {
      allow create: if isAuth() && request.resource.data.relator_uid == request.auth.uid; 
      allow read: if resource.data.status == 'ativa' || isStaff() || (isAuth() && resource.data.relator_uid == request.auth.uid);
      allow update: if isAuth() && resource.data.relator_uid == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if false;
    }

    match /denuncias_telefones/{docId} {
      allow create: if isAuth() && request.resource.data.relator_uid == request.auth.uid;
      allow read: if resource.data.status == 'ativa' || isStaff() || (isAuth() && resource.data.relator_uid == request.auth.uid);
      allow update: if isAuth() && resource.data.relator_uid == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if false;
    }

    match /denuncias_sites/{docId} {
      allow create: if isAuth() && request.resource.data.relator_uid == request.auth.uid;
      allow read: if isAuth() && (resource.data.status == 'ativa' || isStaff() || resource.data.relator_uid == request.auth.uid);
      allow update: if isAuth() && resource.data.relator_uid == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
